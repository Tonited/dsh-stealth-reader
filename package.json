{
  "name": "dsh-stealth-reader",
  "version": "0.1.0",
  "description": "DeepSeek Harness 客户端插件：把 txt/epub 小说与真实会话痕迹逐行交错成日志流，鼠标一动即回到工作界面。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "author": "Ashley Lin <44889191+Tonited@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tonited/dsh-stealth-reader.git"
  },
  "homepage": "https://github.com/Tonited/dsh-stealth-reader#readme",
  "bugs": {
    "url": "https://github.com/Tonited/dsh-stealth-reader/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "reader",
    "epub",
    "txt",
    "boss-key",
    "privacy"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "deploy": "node deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "tsc --noEmit && node build.mjs && node --test"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
